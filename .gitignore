# gitignore
ssh*
# ignore PBS log files (<jobname>.e12345, .o12345, and array forms .o12345.1) -
# not every file with a dot followed by e or o, which also hid .eps, .out, .org
*.[eo][0-9]*
*.ER
*.OU
*logs*/
*failed*_ids*.txt
# ignore compiled rmd files
*.html
*README_files/
# ignore random test bits (scoped to scratch/ - the old repo-wide *test*.* rule
# silently excluded crossfitting/cf_testing.R, the verification harness that
# crossfitting/README.md tells you to run before submitting any job)
scratch/*test*
# regression harness baselines - machine-local, re-captured not shared
.regression_baseline/
# old things that will not be used/updated
*deprecated*/
*old*/
.Rproj.user
.Rhistory
*.pdf
*ADEMP_files/
case_study/
results_processing/thesis_tables/appendix-table-shortening.md
